{
  "name": "dancing-with-sars",
  "version": "1.0.0",
  "description": "Dancing with SARs by Feynman Diagrams: an interactive NISAR radar explorer for Downtown Miami, Miami Beach and the Everglades (NASA Space Apps Challenge).",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:server\" \"npm:client\"",
    "server": "node server/index.js",
    "client": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "fetch:nisar": "node scripts/fetch-nisar.js",
    "fetch:lights": "node scripts/fetch-lights.js",
    "fetch:satellites": "node scripts/fetch-satellites.js",
    "fetch:weather-maps": "node scripts/fetch-weather-maps.js",
    "fetch:all": "npm run fetch:nisar && npm run fetch:lights && npm run fetch:satellites && npm run fetch:weather-maps"
  },
  "dependencies": {
    "@deck.gl/core": "^9.4.1",
    "@deck.gl/layers": "^9.4.1",
    "@deck.gl/mapbox": "^9.4.1",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "maplibre-gl": "^5.24.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "vite": "^8.3.8"
  }
}
